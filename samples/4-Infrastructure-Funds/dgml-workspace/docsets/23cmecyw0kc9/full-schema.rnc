# ==========================================================================
# DGML docset schema — Periodic Financial Reporting Package
# RELAX NG Compact.  Data types observed in 10 .dgml.xml file(s):
#   element text is the RAW page text; the normalized, typed value is
#   carried by @dg:value, described by @xsi:type (XSD built-in names).
# `# Field: value` comments are the LOSSLESS schema.json serialization;
#   regenerate the JSON via dgml_core.generation.rnc.rnc_to_schema_dict.
# ==========================================================================

default namespace docset = "http://dgml.io/acme-inc/PeriodicFinancialReportingPackage"
namespace dg = "http://dgml.io/ns/dg#"
namespace xsi = "http://www.w3.org/2001/XMLSchema-instance"
datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"

start = dg.chunk

# --- attributes common to every DGML element ------------------------
# dg:origin  = grounding bbox: "page x1 y1 x2 y2"
# dg:itemprop / dg:href = semantic link (predicate + '#id' target(s))
common.atts =
  attribute dg:structure { text }?,
  attribute dg:origin { text }?,
  attribute xml:id { xsd:ID }?,
  attribute dg:itemprop { text }?,
  attribute dg:href { text }?,
  attribute dg:value { text }?,
  attribute xsi:type { text }?

# --- generic structural chunk (unlabeled scaffolding) ----------------
dg.chunk = element dg:chunk { common.atts, mixed { any.docset* } }

# a concept private to ONE document renders in the dg: namespace instead
# of docset: (the shared-tag rule) — same shape, unshared vocabulary
dg.private = element dg:* { common.atts, mixed { any.docset* } }

# any docset element may appear where structure allows it
any.docset = dg.chunk
  | dg.private
  | AccumulatedDepreciation
  | ActualVsBudget
  | AdministrativeCost
  | AssetGrossBookValue
  | AssetName
  | AssetNetCarryingValue
  | BalanceSheet
  | BalanceSheetCarryingValue
  | BudgetedNetOperatingIncome
  | CashAndReserves
  | CashFlow
  | CashFlowAmount
  | CashFlowFromOperations
  | CashFlowItemName
  | ConsolidatedIncome
  | CorridorSegmentPerformance
  | CostVariance
  | CovenantActualRatio
  | CovenantComplianceNarrative
  | CovenantComplianceStatus
  | CovenantContractualMinimum
  | CovenantMetricName
  | CovenantMetrics
  | CustomerSegmentName
  | DSCRCovenantFloor
  | DebtCovenant
  | DebtServiceCoverageRatio
  | DebtYieldRatio
  | DirectCost
  | EngineeringCertification
  | GrantAllocation
  | GrossRevenue
  | HospitalityFinancialMetrics
  | IndustrialOutput
  | InterconnectionOrSurchargeRevenue
  | LeaseRevenue
  | LiabilityClassName
  | LiabilityMaturityPeriod
  | LiabilityOutstandingBalance
  | LicenseFeeRevenue
  | LoanToValueRatio
  | NetOperatingIncome
  | NetOperatingIncomeVariance
  | NetSegmentMargin
  | Occupancy
  | OperationalSegment
  | OperationalSegmentName
  | PhysicalOutputVolume
  | PowerGenerationBySegment
  | PowerGenerationRecord
  | ProcessingSurcharge
  | PropertyPlantEquipment
  | QuarterlyOutputTarget
  | RefiningOrProcessingMargin
  | ReportingEntityName
  | ReportingPackage
  | ReportingPeriod
  | ReserveAccountBalance
  | ReserveAccountName
  | ReserveBalance
  | ReserveRestrictionStatus
  | RevenueVariance
  | SegmentCostActual
  | SegmentCostBudget
  | SegmentOperational
  | SegmentOperations
  | SegmentProduction
  | SegmentRevenueActual
  | SegmentRevenueBudget
  | ShieldingOrContainmentCost
  | StatementOfOperations
  | SubmittingParty
  | TariffRate
  | TotalCost
  | TotalLiabilities
  | TotalNetIncome
  | TotalPhysicalVolume
  | TotalRevenue
  | UnitPrice

# ------------------------------------------------------------------
# Description: "Accumulated depreciation, wear, or amortisation applied against a physical asset"
# Kind: inline
# Parent: BalanceSheet
# Example: "Accumulated Wear (Tidal)"
# Examples: ["Accumulated Wear (Tidal)", "(45,000,000)", "(56,000,000)"]
# Observed: 4 occurrence(s); dg:structure: td(4)
AccumulatedDepreciation = element AccumulatedDepreciation {
  common.atts,
  text
}

# ------------------------------------------------------------------
# Description: "Explanatory note describing the reason for a variance between actual and budgeted figures"
# Kind: row
# Parent: ConsolidatedIncome
# Example: "Notes"
# Examples: ["Notes", "Reflects higher offworld tourism occupancy", "Long-term fixed contracts"]
# Observed: 13 occurrence(s); dg:structure: td(12), tr(1)
ActualVsBudget = element ActualVsBudget {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "General administrative, legal, and insurance expenses"
# Kind: row
# Parent: ConsolidatedIncome
# Observed: 1 occurrence(s); dg:structure: tr(1)
AdministrativeCost = element AdministrativeCost {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "Gross book value of a physical asset before depreciation or wear"
# Kind: inline
# Parent: BalanceSheet
# Example: "Gross Book Value"
# Examples: ["Gross Book Value", "450,000,000", "280,000,000"]
# Observed: 4 occurrence(s); dg:structure: td(4)
# Data type (from DGML): integer(3) of 4 occurrence(s)
AssetGrossBookValue = element AssetGrossBookValue {
  attribute dg:structure { text }?,
  attribute dg:origin { text }?,
  attribute xml:id { xsd:ID }?,
  attribute dg:itemprop { text }?,
  attribute dg:href { text }?,
  ((attribute xsi:type { "integer" },
    attribute dg:value { xsd:integer })
   | attribute dg:value { text })?,  # bare dg:value = link payload
  text
}

# ------------------------------------------------------------------
# Description: "Name of a distinct physical or structural asset on the balance sheet"
# Kind: inline
# Parent: BalanceSheet
# Example: "Physical / Structural Asset"
# Examples: ["Physical / Structural Asset", "Titanium-Glass Dome Units", "Hydrothermal Energy Interface"]
# Observed: 4 occurrence(s); dg:structure: td(4)
AssetName = element AssetName {
  common.atts,
  text
}

# ------------------------------------------------------------------
# Description: "Net carrying value of a physical asset after accumulated depreciation"
# Kind: inline
# Parent: BalanceSheet
# Example: "Net Carrying Value"
# Examples: ["Net Carrying Value", "405,000,000", "224,000,000"]
# Observed: 4 occurrence(s); dg:structure: td(4)
# Data type (from DGML): integer(3) of 4 occurrence(s)
AssetNetCarryingValue = element AssetNetCarryingValue {
  attribute dg:structure { text }?,
  attribute dg:origin { text }?,
  attribute xml:id { xsd:ID }?,
  attribute dg:itemprop { text }?,
  attribute dg:href { text }?,
  ((attribute xsi:type { "integer" },
    attribute dg:value { xsd:integer })
   | attribute dg:value { text })?,  # bare dg:value = link payload
  text
}

# ------------------------------------------------------------------
# Description: "Recurring section presenting asset, liability, and reserve account carrying values"
# Kind: section
# Parent: ReportingPackage
# Example: "Consolidated Balance Sheet & Reserve Accounts"
# Examples: ["Consolidated Balance Sheet & Reserve Accounts"]
# Observed: 11 occurrence(s); dg:structure: tr(9), section(1), table(1)
# Children (from schema hierarchy): AccumulatedDepreciation, AssetGrossBookValue, AssetName, AssetNetCarryingValue, CashAndReserves, LiabilityClassName, LiabilityMaturityPeriod, LiabilityOutstandingBalance, PropertyPlantEquipment, ReserveBalance, ReserveRestrictionStatus, TotalLiabilities
BalanceSheet = element BalanceSheet {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "Total carrying value assigned to a broad balance sheet category"
# Kind: inline
# Observed: 3 occurrence(s); dg:structure: td(3)
# Data type (from DGML): integer(3) of 3 occurrence(s)
BalanceSheetCarryingValue = element BalanceSheetCarryingValue {
  attribute dg:structure { text }?,
  attribute dg:origin { text }?,
