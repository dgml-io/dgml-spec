<dg:chunk xmlns:dg="http://dgml.io/ns/dg#" xmlns:docset="http://dgml.io/acme-inc/CommercialLeaseAgreement" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xhtml="http://www.w3.org/1999/xhtml" dg:origin="1 122 120 2349 3127">
  <docset:PropertyPortfolioLabel dg:structure="p" dg:origin="1 122 120 1253 153" dg:style="font-weight: bold">Property 4: Arcadia Biotech Park, Module 4 (Research &amp; Development)</docset:PropertyPortfolioLabel>
  <docset:LeaseAgreementType dg:structure="p" dg:origin="1 122 213 857 244" dg:style="font-weight: bold">Commercial Pressurized Space Lease Agreement</docset:LeaseAgreementType>
  <dg:chunk dg:structure="p" dg:origin="1 122 299 1114 330" dg:style="font-weight: bold">LANDLORD: <docset:LandlordName dg:origin="1 317 299 711 330" dg:style="font-weight: normal">Ares Prime Yield Fund I, LP</docset:LandlordName>, a <docset:LandlordEntityType dg:origin="1 746 299 1114 330" dg:style="font-weight: normal">Martian limited partnership</docset:LandlordEntityType>
  </dg:chunk>
  <dg:chunk dg:structure="p" dg:origin="1 122 346 1010 377" dg:style="font-weight: bold">TENANT: <docset:TenantName dg:origin="1 268 346 706 377" dg:style="font-weight: normal">Martian Biotech Synthetics Inc.</docset:TenantName>, a <docset:TenantEntityType dg:origin="1 741 346 1010 377" dg:style="font-weight: normal">Martian corporation</docset:TenantEntityType>
  </dg:chunk>
  <docset:LeaseAgreementType dg:structure="section" dg:origin="1 122 468 2272 766">
    <dg:chunk dg:structure="header" dg:origin="1 122 468 1006 499" dg:style="font-weight: bold; text-transform: uppercase">COMMERCIAL PRESSURIZED SPACE LEASE AGREEMENT</dg:chunk>
    <docset:Recital dg:structure="p" dg:origin="1 122 554 2272 586; 1 122 601 2264 632; 1 122 648 1239 679">THIS COMMERCIAL PRESSURIZED SPACE LEASE AGREEMENT (this "Lease") is made and entered into this <docset:EffectiveDate xsi:type="date" dg:value="2084-11-01" dg:origin="1 1699 554 1965 586" xml:id="effectivedate">November 1, 2084</docset:EffectiveDate>, by and between <docset:LandlordName dg:origin="1 2203 554 2272 586; 1 122 601 461 632" dg:style="font-weight: bold">Ares Prime Yield Fund I, LP</docset:LandlordName>, a <docset:LandlordEntityType dg:origin="1 496 601 864 632">Martian limited partnership</docset:LandlordEntityType> (hereinafter referred to as "Landlord"), and <docset:TenantName dg:origin="1 1487 601 1960 632" dg:style="font-weight: bold">Martian Biotech Synthetics Inc.</docset:TenantName>, a <docset:TenantEntityType dg:origin="1 1995 601 2264 632">Martian corporation</docset:TenantEntityType> registered under Registry No. <docset:TenantRegistrationNumber dg:origin="1 539 648 716 679">MC-30291-B</docset:TenantRegistrationNumber> (hereinafter referred to as "Tenant").</docset:Recital>
    <docset:Recital dg:structure="p" dg:origin="1 122 735 338 766" dg:style="font-weight: bold; text-transform: uppercase">WITNESSETH:</docset:Recital>
  </docset:LeaseAgreementType>
  <docset:PremisesDescription dg:structure="section" dg:origin="1 122 821 2349 1190">
    <dg:chunk dg:structure="header" dg:origin="1 122 821 749 852" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 1: PREMISES, TERM, AND RENT</dg:chunk>
    <dg:chunk dg:structure="ol" dg:origin="1 169 907 2349 1190">
      <docset:PremisesDescription dg:structure="li" dg:origin="1 169 907 2201 939; 1 169 954 977 986">
        <dg:chunk dg:structure="lim" dg:origin="1 169 907 221 939" dg:style="font-weight: bold">1.1.</dg:chunk> Premises: <docset:ZoneIdentifier dg:origin="1 388 907 515 939" xml:id="zoneidentifier">Sector F</docset:ZoneIdentifier>, <docset:SuiteOrSectorIdentifier dg:origin="1 523 907 661 939">Module 4</docset:SuiteOrSectorIdentifier>, <docset:PropertyPortfolioLabel dg:origin="1 669 907 970 939">Arcadia Biotech Park</docset:PropertyPortfolioLabel>, <docset:DomeFacilityIdentifier dg:origin="1 979 907 1097 939" xml:id="domefacilityidentifier">Dome 4</docset:DomeFacilityIdentifier>, Ares Prime, containing approximately <docset:PremisesArea dg:origin="1 1632 907 1918 939">6,200 square meters</docset:PremisesArea> of <docset:PremisesUseType dg:origin="1 1962 907 2201 939; 1 169 954 718 986">high-containment biochemical laboratory and office space</docset:PremisesUseType> (the "Premises").</docset:PremisesDescription>
      <dg:chunk dg:structure="li" dg:origin="1 169 1010 2346 1041; 1 169 1056 271 1088">
        <dg:chunk dg:structure="lim" dg:origin="1 169 1010 221 1041" dg:style="font-weight: bold">1.2.</dg:chunk> Term: <docset:LeaseTerm dg:origin="1 325 1010 701 1041">Twelve (12) Martian Years</docset:LeaseTerm>, commencing on <docset:CommencementDate xsi:type="date" dg:value="2084-11-01" dg:origin="1 938 1010 1196 1041" xml:id="commencementdate" dg:itemprop="effectiveOn" dg:href="#effectivedate">November 1, 2084</docset:CommencementDate> (the "Commencement Date"), and expiring on <docset:ExpirationDate xsi:type="date" dg:value="2096-10-31" dg:origin="1 1866 1010 2107 1041" xml:id="expirationdate" dg:itemprop="relativeTo" dg:href="#commencementdate">October 31, 2096</docset:ExpirationDate> (the "Expiration Date").</dg:chunk>
      <dg:chunk dg:structure="li" dg:origin="1 169 1112 2349 1143; 1 169 1158 2345 1190">
        <dg:chunk dg:structure="lim" dg:origin="1 169 1112 221 1143" dg:style="font-weight: bold">1.3.</dg:chunk> Base Rent: Initial Base Rent shall be <docset:BaseRent dg:origin="1 754 1112 1946 1143" xml:id="baserent">Three Million Two Hundred Twenty-Four Thousand Martian Credits (M$ 3,224,000.00)</docset:BaseRent> per annum (representing <docset:BaseRentPerSquareMeter dg:origin="1 2305 1112 2349 1143; 1 169 1158 395 1190">M$ 520.00 per sq.m.</docset:BaseRentPerSquareMeter>), payable in monthly installments of <docset:MonthlyRentInstallment dg:origin="1 909 1158 2345 1190">Two Hundred Sixty-Eight Thousand Six Hundred Sixty-Six and 67/100 Martian Credits (M$ 268,666.67)</docset:MonthlyRentInstallment>.</dg:chunk>
    </dg:chunk>
  </docset:PremisesDescription>
  <docset:RentEscalationFormula dg:structure="section" dg:origin="1 122 1245 2293 1410">
    <dg:chunk dg:structure="header" dg:origin="1 122 1245 621 1276" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 2: RENT ESCALATIONS</dg:chunk>
    <dg:chunk dg:structure="ol" dg:origin="1 169 1331 2293 1410">
      <docset:RentEscalationFormula dg:structure="li" dg:origin="1 169 1331 2293 1363; 1 169 1378 1213 1410">
        <dg:chunk dg:structure="lim" dg:origin="1 169 1331 221 1363" dg:style="font-weight: bold">2.1.</dg:chunk> Fixed Annual Escalations: On <docset:RentEscalationInterval dg:origin="1 678 1331 1324 1363" xml:id="rentescalationinterval" dg:itemprop="relativeTo" dg:href="#commencementdate" dg:value="P1Y">each anniversary of the Commencement Date</docset:RentEscalationInterval>, the Base Rent shall increase by exactly <docset:RentEscalationRate dg:origin="1 1887 1331 2172 1363" xml:id="rentescalationrate" dg:itemprop="escalates" dg:href="#baserent" dg:value="0.03">three percent (3.0%)</docset:RentEscalationRate> over the Base Rent in effect for the immediately preceding twelve (12) month period.</docset:RentEscalationFormula>
    </dg:chunk>
  </docset:RentEscalationFormula>
  <docset:TenantImprovementAllowance dg:structure="section" dg:origin="1 122 1465 2340 1676">
    <dg:chunk dg:structure="header" dg:origin="1 122 1465 692 1496" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 3: TENANT IMPROVEMENTS</dg:chunk>
    <dg:chunk dg:structure="ol" dg:origin="1 169 1551 2340 1676">
      <dg:chunk dg:structure="li" dg:origin="1 169 1551 2293 1582; 1 169 1598 2340 1629; 1 169 1645 1321 1676">
        <dg:chunk dg:structure="lim" dg:origin="1 169 1551 221 1582" dg:style="font-weight: bold">3.1.</dg:chunk> Cleanroom TI Allowance: Landlord shall provide Tenant with a TI Allowance of <docset:TenantImprovementAllowance dg:origin="1 1345 1551 2231 1582">Nine Hundred Thirty Thousand Martian Credits (M$ 930,000.00)</docset:TenantImprovementAllowance> (<docset:TenantImprovementAllowancePerSquareMeter dg:origin="1 2250 1551 2293 1582; 1 169 1598 395 1629">M$ 150.00 per sq.m.</docset:TenantImprovementAllowancePerSquareMeter>) specifically for the <docset:TIAllowanceUseDescription dg:origin="1 680 1598 2340 1629; 1 169 1645 327 1676">installation of Class-10 pressurized biosafety isolation barriers and independent emergency hydrogen-cell backup power generators</docset:TIAllowanceUseDescription>. No free rent concessions or abatements are provided under this Lease.</dg:chunk>
    </dg:chunk>
  </docset:TenantImprovementAllowance>
  <docset:LifeSupportAndAtmosphericSystemsObligation dg:structure="section" dg:origin="1 122 1731 2347 2045">
    <dg:chunk dg:structure="header" dg:origin="1 122 1731 1227 1763" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 4: LIFE SUPPORT SYSTEMS AND BASE YEAR EXPENSE STOPS</dg:chunk>
    <dg:chunk dg:structure="ol" dg:origin="1 169 1818 2347 2045">
      <docset:BaseYearExpenseStop dg:structure="li" dg:origin="1 169 1818 2279 1849; 1 169 1865 869 1896">
        <dg:chunk dg:structure="lim" dg:origin="1 169 1818 221 1849" dg:style="font-weight: bold">4.1.</dg:chunk> Base Year Expense Stop: This Lease is structured as an NNN Lease with a Base Year lock on primary atmospheric utility costs. The Base Year for calculating LSS operating expenses shall be <docset:BaseYear xsi:type="gYear" dg:value="2084" dg:origin="1 791 1865 869 1896" xml:id="baseyear" dg:itemprop="effectiveOn" dg:href="#commencementdate">2084</docset:BaseYear>.</docset:BaseYearExpenseStop>
      <docset:UtilityAndOperatingExpenseResponsibility dg:structure="li" dg:origin="1 169 1920 2342 1951; 1 169 1967 2347 1998; 1 169 2014 1414 2045">
        <dg:chunk dg:structure="lim" dg:origin="1 169 1920 221 1951" dg:style="font-weight: bold">4.2.</dg:chunk> Metering: All specialized climate control, localized autoclave operations, and hazardous waste venting systems shall be independently metered and paid for <dg:chunk dg:structure="span" xsi:type="decimal" dg:value="100" dg:origin="1 214 1967 294 1998">100%</dg:chunk> by Tenant as Additional Rent. Landlord's recovery of general Dome 4 atmospheric and shell maintenance costs shall be subject to audit by Tenant's third-party environmental accountants within <docset:ReportingDeadline dg:origin="1 789 2014 1006 2045">ninety (90) Sols</docset:ReportingDeadline> of annual statement delivery.</docset:UtilityAndOperatingExpenseResponsibility>
    </dg:chunk>
  </docset:LifeSupportAndAtmosphericSystemsObligation>
  <dg:RightOfFirstRefusal dg:structure="section" dg:origin="1 122 2100 2321 3127">
    <dg:chunk dg:structure="header" dg:origin="1 122 2100 1322 2131" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 5: RIGHTS OF FIRST REFUSAL AND DECOMMISSIONING COVENANTS</dg:chunk>
    <dg:chunk dg:structure="ol" dg:origin="1 169 2187 2321 2414">
      <dg:RightOfFirstRefusal dg:structure="li" dg:origin="1 169 2187 2321 2218; 1 169 2233 959 2265" xml:id="rightoffirstrefusal" dg:itemprop="references" dg:href="#zoneidentifier">
        <dg:chunk dg:structure="lim" dg:origin="1 169 2187 221 2218" dg:style="font-weight: bold">5.1.</dg:chunk> Right of First Refusal (ROFR): Tenant shall have a Right of First Refusal to lease any <docset:PremisesDescription dg:origin="1 1442 2187 2321 2218; 1 169 2233 536 2265" xml:id="premisesdescription" dg:itemprop="references" dg:href="#domefacilityidentifier">sub-surface subterranean vaults developed by Landlord directly beneath Dome 4, Sector F</docset:PremisesDescription> during the Term of this Lease.</dg:RightOfFirstRefusal>
      <dg:DecommissioningCovenant dg:structure="li" dg:origin="1 169 2289 2311 2320; 1 169 2336 2286 2367; 1 169 2382 1810 2414">
        <dg:chunk dg:structure="lim" dg:origin="1 169 2289 221 2320" dg:style="font-weight: bold">5.2.</dg:chunk> Mandated Biological Decontamination: Upon the expiration or earlier termination of this Lease, Tenant, at its sole cost and expense, shall execute a comprehensive biological and radiochemical decontamination of the Premises. Such work must be completed by an authorized contractor licensed by the Ares Health Authority and must achieve a Level-5 Biosafety Declassification before possession is returned to Landlord.</dg:DecommissioningCovenant>
    </dg:chunk>
    <docset:Execution dg:structure="p" dg:origin="1 122 2469 1460 2500">IN WITNESS WHEREOF, the parties have executed this Lease as of the date first above written.</docset:Execution>
    <docset:Execution dg:structure="p" dg:origin="1 122 2555 308 2587" dg:style="font-weight: bold; text-transform: uppercase">LANDLORD:</docset:Execution>
