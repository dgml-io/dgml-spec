    <dg:chunk dg:structure="header" dg:origin="1 122 120 1251 153" dg:style="font-weight: bold">Property 3: Hellas Basin Logistics Complex, Depot Gamma (Industrial)</dg:chunk>
    <docset:LeaseAgreementType dg:structure="section" dg:origin="1 122 213 1216 377">
      <dg:chunk dg:structure="header" dg:origin="1 122 213 857 244" dg:style="font-weight: bold">Commercial Pressurized Space Lease Agreement</dg:chunk>
      <dg:chunk dg:structure="ul" dg:origin="1 122 299 1216 377">
        <dg:chunk dg:structure="li" dg:origin="1 122 299 1114 330">
          <dg:chunk dg:structure="header" dg:origin="1 122 299 308 330" dg:style="font-weight: bold; text-transform: uppercase">LANDLORD:</dg:chunk>
          <dg:chunk dg:structure="p" dg:origin="1 317 299 1114 330">
            <docset:LandlordName dg:origin="1 317 299 1114 330">Ares Prime Yield Fund I, LP, a <docset:LandlordEntityType dg:origin="1 746 299 1114 330">Martian limited partnership</docset:LandlordEntityType>
            </docset:LandlordName>
          </dg:chunk>
        </dg:chunk>
        <dg:chunk dg:structure="li" dg:origin="1 122 346 1216 377">
          <dg:chunk dg:structure="header" dg:origin="1 122 346 259 377" dg:style="font-weight: bold; text-transform: uppercase">TENANT:</dg:chunk>
          <dg:chunk dg:structure="p" dg:origin="1 268 346 1216 377">
            <docset:TenantName dg:origin="1 268 346 1216 377">Phobos Minerals Extraction Group, a <docset:TenantEntityType dg:origin="1 787 346 1216 377">Martian public limited company</docset:TenantEntityType>
            </docset:TenantName>
          </dg:chunk>
        </dg:chunk>
      </dg:chunk>
