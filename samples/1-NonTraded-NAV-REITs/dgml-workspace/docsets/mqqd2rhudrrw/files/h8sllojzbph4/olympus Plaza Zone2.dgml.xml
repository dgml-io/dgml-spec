  <docset:LeaseAgreementType dg:structure="section" dg:origin="1 122 468 2357 3229">
    <dg:chunk dg:structure="header" dg:origin="1 122 468 1006 499" dg:style="font-weight: bold; text-transform: uppercase">COMMERCIAL PRESSURIZED SPACE LEASE AGREEMENT</dg:chunk>
    <dg:chunk dg:structure="p" dg:origin="1 122 554 2300 586; 1 122 601 2309 632; 1 122 648 1479 679">THIS COMMERCIAL PRESSURIZED SPACE LEASE AGREEMENT (this "Lease") is made and entered into this <docset:EffectiveDate xsi:type="date" dg:value="2083-05-15" dg:origin="1 1699 554 1897 586">May 15, 2083</docset:EffectiveDate>, by and between <docset:LandlordName dg:origin="1 2135 554 2300 586; 1 122 601 365 632" dg:style="font-weight: bold">Ares Prime Yield Fund I, LP</docset:LandlordName>, a <docset:LandlordEntityType dg:origin="1 400 601 768 632">Martian limited partnership</docset:LandlordEntityType> (hereinafter referred to as "Landlord"), and <docset:TenantName dg:origin="1 1392 601 2071 632" dg:style="font-weight: bold">The Rusty Rover Diner &amp; Hydro-Brewery LLC</docset:TenantName>, a <docset:TenantEntityType dg:origin="1 2106 601 2309 632; 1 122 648 351 679">Martian limited liability company</docset:TenantEntityType> registered under Registry No. <docset:TenantRegistrationNumber dg:origin="1 777 648 956 679">MC-88301-R</docset:TenantRegistrationNumber> (hereinafter referred to as "Tenant").</dg:chunk>
    <docset:Recital dg:structure="section" dg:origin="1 122 735 338 766">
      <dg:chunk dg:structure="header" dg:origin="1 122 735 338 766" dg:style="font-weight: bold; text-transform: uppercase">WITNESSETH:</dg:chunk>
    </docset:Recital>
    <docset:PremisesDescription dg:structure="section" dg:origin="1 122 821 2328 1096">
      <dg:chunk dg:structure="header" dg:origin="1 122 821 749 852" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 1: PREMISES, TERM, AND RENT</dg:chunk>
      <dg:chunk dg:structure="ol" dg:origin="1 169 907 2328 1096">
        <docset:PremisesDescription dg:structure="li" dg:origin="1 169 907 2328 939">
          <dg:chunk dg:structure="lim">•</dg:chunk> 1.1. Premises: <docset:SuiteOrSectorIdentifier dg:origin="1 388 907 529 939">Suite 142</docset:SuiteOrSectorIdentifier>, <docset:DomeFacilityIdentifier dg:origin="1 537 907 874 939">Dome 2 (Olympus Mall)</docset:DomeFacilityIdentifier>, <docset:ZoneIdentifier dg:origin="1 883 907 989 939">Zone 2</docset:ZoneIdentifier>, Ares Prime, containing approximately <docset:PremisesArea dg:origin="1 1524 907 1784 939">450 square meters</docset:PremisesArea> of <docset:PremisesUseType dg:origin="1 1828 907 2069 939">inline retail space</docset:PremisesUseType> (the "Premises").</docset:PremisesDescription>
        <dg:chunk dg:structure="li" dg:origin="1 169 963 2292 994" dg:style="font-weight: bold">
          <dg:chunk dg:structure="lim">•</dg:chunk> 1.2. Term: <docset:LeaseTerm dg:origin="1 325 963 655 994" dg:style="font-weight: normal">Ten (10) Martian Years</docset:LeaseTerm>, commencing on <docset:CommencementDate xsi:type="date" dg:value="2083-05-15" dg:origin="1 893 963 1083 994" dg:style="font-weight: normal" xml:id="commencementdate">May 15, 2083</docset:CommencementDate> (the "Commencement Date"), and expiring on <docset:ExpirationDate xsi:type="date" dg:value="2093-05-14" dg:origin="1 1753 963 1943 994" dg:style="font-weight: normal" xml:id="expirationdate" dg:itemprop="relativeTo" dg:href="#commencementdate">May 14, 2093</docset:ExpirationDate> (the "Expiration Date").</dg:chunk>
        <dg:chunk dg:structure="li" dg:origin="1 169 1018 2314 1049; 1 169 1065 2092 1096">
          <dg:chunk dg:structure="lim">•</dg:chunk> 1.3. Base Rent: Initial Base Rent shall be <docset:BaseRent dg:origin="1 754 1018 1911 1049" xml:id="baserent">Two Hundred Ninety-Two Thousand Five Hundred Martian Credits (M$ 292,500.00)</docset:BaseRent> per annum (representing <docset:BaseRentPerSquareMeter dg:origin="1 2271 1018 2314 1049; 1 169 1065 395 1096">M$ 650.00 per sq.m.</docset:BaseRentPerSquareMeter>), payable in monthly installments of <docset:MonthlyRentInstallment dg:origin="1 909 1065 2092 1096" xml:id="monthlyrentinstallment" dg:itemprop="valueFrom" dg:href="#baserent" dg:value="1/12">Twenty-Four Thousand Three Hundred Seventy-Five Martian Credits (M$ 24,375.00)</docset:MonthlyRentInstallment>.</dg:chunk>
      </dg:chunk>
    </docset:PremisesDescription>
    <docset:RentEscalationFormula dg:structure="section" dg:origin="1 122 1151 2357 1465">
      <dg:chunk dg:structure="header" dg:origin="1 122 1151 1016 1182" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 2: RENT ESCALATIONS AND PERCENTAGE RENT</dg:chunk>
      <dg:chunk dg:structure="ol" dg:origin="1 169 1238 2357 1465">
        <docset:RentEscalationFormula dg:structure="li" dg:origin="1 169 1238 2356 1269; 1 169 1285 1133 1316" xml:id="rentescalationformula" dg:itemprop="relativeTo" dg:href="#commencementdate" dg:value="P1Y">
          <dg:chunk dg:structure="lim">•</dg:chunk> 2.1. Fixed Annual Escalations: On each anniversary of the Commencement Date, the Base Rent shall increase by exactly <docset:RentEscalationRate dg:origin="1 1887 1238 2154 1269" xml:id="rentescalationrate" dg:itemprop="escalates" dg:href="#baserent" dg:value="0.04">four percent (4.0%)</docset:RentEscalationRate> over the Base Rent in effect for the immediately preceding <docset:RentEscalationInterval dg:origin="1 781 1285 1133 1316">twelve (12) month period</docset:RentEscalationInterval>.</docset:RentEscalationFormula>
        <dg:PercentageRent dg:structure="li" dg:origin="1 169 1340 2277 1371; 1 169 1387 2285 1418; 1 169 1433 2357 1465">
          <dg:chunk dg:structure="lim">•</dg:chunk> 2.2. Percentage Rent: In addition to the Base Rent, Tenant shall pay to Landlord as Percentage Rent an amount equal to <dg:PercentageRentRate dg:origin="1 1863 1340 2115 1371" xml:id="percentagerentrate">six percent (6.0%)</dg:PercentageRentRate> of Tenant's annual gross sales made from or on the Premises in excess of a natural annual breakpoint of <dg:PercentageRentBreakpoint dg:origin="1 1463 1387 2285 1418; 1 169 1433 541 1465" xml:id="percentagerentbreakpoint" dg:itemprop="valueFrom" dg:href="#baserent">Four Million Eight Hundred Seventy-Five Thousand Martian Credits (M$ 4,875,000.00)</dg:PercentageRentBreakpoint>. Gross sales reports shall be certified by an independent accountant and submitted within <docset:ReportingDeadline dg:origin="1 1784 1433 1986 1465">thirty (30) Sols</docset:ReportingDeadline> of each Lease Year's end.</dg:PercentageRent>
      </dg:chunk>
    </docset:RentEscalationFormula>
    <docset:TenantImprovementAllowance dg:structure="section" dg:origin="1 122 1520 2328 1833">
      <dg:chunk dg:structure="header" dg:origin="1 122 1520 1048 1551" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 3: TENANT IMPROVEMENTS AND RECOVERY CAPS</dg:chunk>
      <dg:chunk dg:structure="ol" dg:origin="1 169 1606 2328 1833">
        <dg:chunk dg:structure="li" dg:origin="1 169 1606 2328 1638; 1 169 1653 1166 1685; 1 384 1708 395 1740">
          <dg:chunk dg:structure="lim">•</dg:chunk> 3.1. Food Service TI Allowance: Landlord shall provide Tenant with a TI Allowance of <docset:TenantImprovementAllowance dg:origin="1 1378 1606 2126 1638">Forty-Five Thousand Martian Credits (M$ 45,000.00)</docset:TenantImprovementAllowance> (<docset:TenantImprovementAllowancePerSquareMeter dg:origin="1 2126 1606 2328 1638; 1 169 1653 237 1685">M$ 100.00 per sq.m.</docset:TenantImprovementAllowancePerSquareMeter>) for <docset:TIAllowanceUseDescription dg:origin="1 310 1653 1166 1685">grease traps, localized vapor hoods, and carbon dioxide lines</docset:TIAllowanceUseDescription>.</dg:chunk>
        <docset:UtilityAndOperatingExpenseResponsibility dg:structure="li" dg:origin="1 169 1708 2298 1740; 1 169 1755 2316 1787; 1 169 1802 1953 1833">
          <dg:chunk dg:structure="lim">•</dg:chunk> 3.2. Triple-Net (NNN) Recoveries and LSS Cap: Tenant shall pay its proportionate share of Dome 2 retail CAM. However, Landlord agrees that Tenant's annual contribution to regional atmospheric recycling maintenance costs (LSS) shall be capped at a maximum annual escalation of <docset:RecoveryBillingCap dg:origin="1 1984 1755 2246 1787">five percent (5.0%)</docset:RecoveryBillingCap> over the actual recovery costs of the prior year, provided Tenant does not exceed a monthly wastewater recycling limit of <dg:WastewaterRecyclingLimit dg:origin="1 1774 1802 1953 1833">10,000 liters</dg:WastewaterRecyclingLimit>.</docset:UtilityAndOperatingExpenseResponsibility>
      </dg:chunk>
    </docset:TenantImprovementAllowance>
    <docset:CoTenancyRequirement dg:structure="section" dg:origin="1 122 1889 2351 2147">
      <dg:chunk dg:structure="header" dg:origin="1 122 1889 846 1920" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 4: RETAIL CO-TENANCY PROTECTION</dg:chunk>
      <dg:chunk dg:structure="ol" dg:origin="1 169 1975 2351 2147">
        <dg:CoTenancyRemedyRight dg:structure="li" dg:origin="1 169 1975 2316 2006; 1 169 2022 2326 2053; 1 169 2069 2351 2100; 1 169 2116 1247 2147" xml:id="cotenancyremedyright" dg:itemprop="references" dg:href="#anchortenantidentifier">
          <dg:chunk dg:structure="lim">•</dg:chunk> 4.1. Anchor Co-Tenancy Option: The <docset:AnchorTenantIdentifier dg:origin="1 718 1975 1282 2006" xml:id="anchortenantidentifier">United Colonies Commissary (Suite 100)</docset:AnchorTenantIdentifier> is recognized as the critical retail anchor of Dome 2. If the United Colonies Commissary "goes dark" or terminates its lease, and Landlord fails to replace them with a comparable national-credit retail anchor within <docset:CoTenancyGracePeriod dg:origin="1 2058 2022 2326 2053; 1 169 2069 433 2100">one hundred eighty (180) Martian Sols</docset:CoTenancyGracePeriod>, Tenant shall have the right to (a) immediately reduce its rent payment to Percentage Rent only (<docset:CoTenancyRemedyRate dg:origin="1 1765 2069 2012 2100" xml:id="cotenancyremedyrate" dg:itemprop="references" dg:href="#percentagerentrate">6% of gross sales</docset:CoTenancyRemedyRate>) in lieu of all Base Rent, or (b) terminate this Lease upon <docset:EarlyTerminationNoticePeriod dg:origin="1 621 2116 822 2147">thirty (30) Sols</docset:EarlyTerminationNoticePeriod>' written notice without penalty.</dg:CoTenancyRemedyRight>
      </dg:chunk>
    </docset:CoTenancyRequirement>
    <docset:PersonalGuaranty dg:structure="section" dg:origin="1 122 2202 2352 2516">
      <dg:chunk dg:structure="header" dg:origin="1 122 2202 971 2233" dg:style="font-weight: bold; text-transform: uppercase">ARTICLE 5: PERSONAL GUARANTY AND SIDE LETTERS</dg:chunk>
      <dg:chunk dg:structure="ol" dg:origin="1 169 2289 2352 2516">
        <docset:PersonalGuaranty dg:structure="li" dg:origin="1 169 2289 2352 2320; 1 169 2336 645 2367" xml:id="personalguaranty" dg:itemprop="guarantorOf" dg:href="#guarantorname">
          <dg:chunk dg:structure="lim">•</dg:chunk> 5.1. Personal Guaranty: This Lease is unconditionally guaranteed by the personal assets of <docset:GuarantorName dg:origin="1 1458 2289 1652 2320" xml:id="guarantorname">Virgil Grissom</docset:GuarantorName> and Dr. Helen Sharman, pursuant to the Guaranty Agreement attached as Exhibit B.</docset:PersonalGuaranty>
        <docset:SideLetter dg:structure="li" dg:origin="1 169 2391 2267 2422; 1 169 2438 2295 2469; 1 169 2485 588 2516">
          <dg:chunk dg:structure="lim">•</dg:chunk> 5.2. <docset:SideLetterIdentifier dg:origin="1 230 2391 477 2422" dg:style="font-weight: bold">Side Letter No. 1</docset:SideLetterIdentifier> (Aromas and Ventilation): Pursuant to Side Letter No. 1, Landlord authorizes Tenant to vent organic, food-safe brewing aromas directly into the Mall tertiary venting grid to stimulate foot traffic, subject to immediate termination if the vapors exceed safety thresholds established by the Dome 2 Air-Quality Taskforce.</docset:SideLetter>
      </dg:chunk>
    </docset:PersonalGuaranty>
