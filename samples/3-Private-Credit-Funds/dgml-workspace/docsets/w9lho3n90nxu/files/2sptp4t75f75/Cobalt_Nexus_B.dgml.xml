    <docset:OperationalNarrative dg:structure="section" dg:origin="1 185 1921 2296 2589">
      <dg:chunk dg:structure="header" dg:origin="1 185 1921 956 1968" dg:style="font-weight: bold; font-size: 1.5em; color: darkslategray">
        <dg:chunk dg:structure="lim" dg:origin="1 185 1921 224 1968">1.</dg:chunk> Financial Performance Narrative</dg:chunk>
      <dg:chunk dg:structure="p" dg:origin="1 185 2177 2296 2209; 1 185 2227 2250 2259" dg:style="color: darkslategray">During the third quarter of 2146, Kraken Dome Sector-4 processed <docset:ProjectedCommodityYield dg:origin="1 1151 2177 1481 2209">12.4 million metric tons</docset:ProjectedCommodityYield> of liquid methane/ethane feedstock, representing a <docset:PeriodVariancePercent xsi:type="decimal" dg:value="4.2" dg:origin="1 2224 2177 2296 2209">4.2%</docset:PeriodVariancePercent> increase over Q2. This performance was achieved despite a minor <docset:OperationalThroughputNarrative dg:origin="1 1112 2227 1220 2259">48-hour</docset:OperationalThroughputNarrative> partial shutdown of Refining Train B due to ice-crust shifts on the lakebed.</dg:chunk>
      <dg:chunk dg:structure="p" dg:origin="1 185 2458 2296 2489; 1 185 2508 2296 2539; 1 185 2558 1908 2589" dg:style="color: darkslategray">Pursuant to <docset:CreditAgreementReference dg:origin="1 361 2458 576 2489" xml:id="creditagreementreference-3" dg:itemprop="references" dg:href="#creditagreementreference-2">Section 2.02(2)</docset:CreditAgreementReference> of the Secured Credit Agreement (Document 1A), because the Atmospheric Integrity Rating remained at <docset:CovenantCompliance dg:origin="1 2125 2458 2255 2489">Grade A-</docset:CovenantCompliance> or better (specifically rated at Grade A by the TRC this quarter), the Atmospheric Risk Premium of <docset:CovenantCompliance dg:origin="1 1550 2508 1798 2539" xml:id="covenantcompliance" dg:itemprop="governedBy" dg:href="#creditagreementreference-3">1.50% per annum</docset:CovenantCompliance> was not triggered. The interest rate on outstanding loans remains calculated strictly at the base floating rate (<docset:CovenantCompliance dg:origin="1 1194 2558 1434 2589" dg:style="font-weight: bold" xml:id="covenantcompliance-2" dg:itemprop="governedBy" dg:href="#creditagreementreference-2">TIDOR plus 4.50%</docset:CovenantCompliance>) as specified in <docset:CreditAgreementReference dg:origin="1 1687 2558 1908 2589" xml:id="creditagreementreference-2">Section 2.02(1)</docset:CreditAgreementReference>.</dg:chunk>
    </docset:OperationalNarrative>
