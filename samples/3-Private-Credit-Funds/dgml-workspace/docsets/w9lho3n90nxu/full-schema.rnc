# ------------------------------------------------------------------
# Description: "A named category or account row within the balance sheet or income statement"
# Kind: inline
# Parent: BalanceSheetColumnHeader
# Example: "Category / Account Item"
# Examples: ["Category / Account Item", "ASSETS", "Cash & Liquid Cryo-Credits"]
# Observed: 224 occurrence(s); dg:structure: td(151), tr(41)
Account = element Account {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "A reference to the accounting standard framework under which the financial statements are prepared"
# Kind: inline
AccountingStandardReference = element AccountingStandardReference {
  common.atts,
  text
}

# ------------------------------------------------------------------
# Description: "The lender or consortium acting as administrative agent for the credit facility"
# Kind: inline
# Observed: 9 occurrence(s)
AdministrativeAgent = element AdministrativeAgent {
  common.atts,
  text
}

# ------------------------------------------------------------------
# Description: "The projected annual output or yield of the primary commodity under each scenario"
# Kind: row
# Parent: NAVModeling
# Example: "4,680 kilograms"
# Examples: ["4,680 kilograms", "4,500 kilograms", "1,200 kilograms"]
# Observed: 11 occurrence(s); dg:structure: tr(6)
# Children (from schema hierarchy): BaseCaseCommodityYield, BearCaseCommodityYield, BullCaseCommodityYield
AnnualCommodityYield = element AnnualCommodityYield {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "The annualized gross revenue projected under each valuation scenario"
# Kind: row
# Parent: NAVModeling
# Example: "SC 2,168.40m"
# Examples: ["SC 2,168.40m", "SC 4,050.00m", "SC 3,660.80m"]
# Observed: 9 occurrence(s); dg:structure: tr(6)
# Children (from schema hierarchy): BaseCaseGrossRevenue, BearCaseGrossRevenue, BullCaseGrossRevenue
AnnualizedGrossRevenue = element AnnualizedGrossRevenue {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "The annualized recurring maintenance or consumable cost deducted in the NAV model"
# Kind: row
# Parent: NAVModeling
# Example: "(500.00)"
# Examples: ["(500.00)"]
# Observed: 9 occurrence(s); dg:structure: tr(6), td(3)
# Children (from schema hierarchy): BaseCaseAnnualizedMaintenanceCost, BaseCaseMaintenanceCost, BearCaseAnnualizedMaintenanceCost, BearCaseMaintenanceCost, BullCaseAnnualizedMaintenanceCost, BullCaseMaintenanceCost
AnnualizedMaintenanceCost = element AnnualizedMaintenanceCost {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "The net operating income projected annually under each valuation scenario"
# Kind: row
# Parent: NAVModeling
# Example: "SC 920.40m"
# Examples: ["SC 920.40m"]
# Observed: 7 occurrence(s); dg:structure: tr(6)
# Children (from schema hierarchy): BaseCaseAnnualizedNOI, BearCaseAnnualizedNOI, BullCaseAnnualizedNOI
AnnualizedNOI = element AnnualizedNOI {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "The annualized primary operating or utility cost deducted in the NAV model"
# Kind: row
# Parent: NAVModeling
# Example: "(1,580.40)"
# Examples: ["(1,580.40)", "(1,620.00)", "(1,540.00)"]
# Observed: 9 occurrence(s); dg:structure: tr(6), td(3)
# Children (from schema hierarchy): BaseCaseAnnualizedOperatingCost, BaseCaseOperatingCost, BearCaseAnnualizedOperatingCost, BearCaseOperatingCost, BullCaseAnnualizedOperatingCost, BullCaseOperatingCost
AnnualizedOperatingCost = element AnnualizedOperatingCost {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "The column header row labeling account item, current period, prior period, and variance in the balance sheet table"
# Kind: row
# Parent: ConsolidatedBalanceSheetIncome
# Observed: 17 occurrence(s); dg:structure: tr(17)
# Children (from schema hierarchy): Account, BaseCaseCommodityPrice, BearCaseCommodityPrice, BullCaseCommodityPrice, CurrentPeriodValue, ValuationScenarioParameter
BalanceSheetColumnHeader = element BalanceSheetColumnHeader {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "Base Case Annualized Maintenance Cost"
# Kind: inline
# Parent: AnnualizedMaintenanceCost
# Example: "(161.20)"
