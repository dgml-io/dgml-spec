# ------------------------------------------------------------------
# Description: "The net operating income projected under the base case commodity price scenario"
# Kind: inline
# Parent: AnnualizedNOI
# Example: "703.00"
# Examples: ["703.00", "1,088.80", "1,187.20"]
# Observed: 7 occurrence(s); dg:structure: td(7)
# Data type (from DGML): decimal(7) of 7 occurrence(s)
BaseCaseAnnualizedNOI = element BaseCaseAnnualizedNOI {
  attribute dg:structure { text }?,
  attribute dg:origin { text }?,
  attribute xml:id { xsd:ID }?,
  attribute dg:itemprop { text }?,
  attribute dg:href { text }?,
  ((attribute xsi:type { "decimal" },
