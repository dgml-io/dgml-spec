  <docset:DefinedTerms dg:structure="section" dg:origin="2 199 196 2275 2450">
    <dg:chunk dg:structure="header" dg:origin="2 199 196 1376 243" dg:style="font-weight: bold; font-size: 1.5em; text-transform: uppercase; color: darkslategray">ARTICLE I: DEFINITIONS AND ACCOUNTING TERMS</dg:chunk>
    <docset:DefinedTerms dg:structure="section" dg:origin="2 199 481 2275 2450">
      <dg:chunk dg:structure="header" dg:origin="2 199 481 625 513" dg:style="font-weight: bold; color: darkslategray">
        <dg:chunk dg:structure="lim" dg:origin="2 321 481 390 513">1.01</dg:chunk> Section 1.01. Defined Terms.</dg:chunk>
      <dg:chunk dg:structure="p" dg:origin="2 634 481 1780 513" dg:style="color: darkslategray">As used in this Agreement, the following terms have the meanings specified below:</dg:chunk>
      <dg:chunk dg:structure="ol" dg:origin="2 231 819 2275 2450">
        <docset:DefinedTerms dg:structure="li" dg:origin="2 245 819 2167 850; 2 231 869 1182 900; 2 231 1981 245 2013" dg:style="color: darkslategray">
          <dg:chunk dg:structure="lim">•</dg:chunk> "<docset:AgreementEffectiveDate dg:origin="2 245 819 436 850" dg:style="font-weight: bold">Closing Date</docset:AgreementEffectiveDate>" means the date on which this Agreement is executed by all participating parties, as designated next to each signature in the signature blocks below (such execution date, the "Signature Date").</docset:DefinedTerms>
        <docset:DefinedTerms dg:structure="li" dg:origin="2 231 1206 2219 1238; 2 231 1256 646 1288" dg:style="color: darkslategray" xml:id="definedterms">
          <dg:chunk dg:structure="lim">•</dg:chunk> "Decompression Mitigation Protocol" means the deployment sequence of rapid aerosol-based self-healing foam sealant into structural stress points of the habitation spires.</docset:DefinedTerms>
        <docset:DefinedTerms dg:structure="li" dg:origin="2 231 1594 2238 1625; 2 231 1644 651 1675" dg:style="color: darkslategray">
          <dg:chunk dg:structure="lim">•</dg:chunk> "He-3 Supply Index" means the monthly unit price of Helium-3 isotope canisters imported from lunar orbital suppliers, as used to power the local secondary backup generators.</docset:DefinedTerms>
        <docset:DefinedTerms dg:structure="li" dg:origin="2 245 1981 2275 2013; 2 231 2031 1283 2073" dg:style="color: darkslategray" xml:id="definedterms-2">
          <dg:chunk dg:structure="lim">•</dg:chunk> "Pressurized Volume Unit" or "PVU" means one million cubic meters of gas mix at standard Earth surface density, containing not less than <dg:chunk dg:structure="span" xsi:type="decimal" dg:value="20.9" dg:origin="2 2186 1981 2275 2013">20.9%</dg:chunk> oxygen (O2), <dg:chunk dg:structure="span" xsi:type="decimal" dg:value="78.1" dg:origin="2 415 2031 504 2063">78.1%</dg:chunk> nitrogen (N2), and less than <dg:chunk dg:structure="span" xsi:type="decimal" dg:value="1.0" dg:origin="2 902 2031 973 2063">1.0%</dg:chunk> carbon dioxide (CO2).</docset:DefinedTerms>
        <docset:DefinedTerms dg:structure="li" dg:origin="2 231 2369 2218 2400; 2 231 2419 837 2450" dg:style="color: darkslategray" xml:id="definedterms-3">
          <dg:chunk dg:structure="lim">•</dg:chunk> "Spires" means the three interconnected structural vertical habitation towers (<docset:FacilityName dg:origin="2 1313 2369 1909 2400">Spire Alpha, Spire Beta, and Spire Gamma</docset:FacilityName>) suspended along the gravity-shear cliffs of Aegaeon Ridge, Titan.</docset:DefinedTerms>
      </dg:chunk>
    </docset:DefinedTerms>
  </docset:DefinedTerms>
  <docset:CreditFacilityCommitment dg:structure="section" dg:origin="2 199 2771 2281 3138; 3 184 197 2235 1391">
    <dg:chunk dg:structure="header" dg:origin="2 199 2771 1074 2818" dg:style="font-weight: bold; font-size: 1.5em; text-transform: uppercase; color: darkslategray">ARTICLE II: THE MEZZANINE FACILITY</dg:chunk>
    <docset:CreditFacilityCommitment dg:structure="section" dg:origin="2 199 3056 2281 3138">
      <dg:chunk dg:structure="header" dg:origin="2 199 3056 717 3088" dg:style="font-weight: bold; color: darkslategray">
        <dg:chunk dg:structure="lim" dg:origin="2 322 3056 392 3088">2.01</dg:chunk> Section 2.01. The Mezzanine Loan.</dg:chunk>
      <docset:CreditFacilityCommitment dg:structure="p" dg:origin="2 726 3056 2281 3088; 2 199 3106 1827 3138" dg:style="color: darkslategray">Subject to the terms and conditions set forth herein, the Lender agrees to make a single advance Subordinated Mezzanine Loan to the Borrower on the Closing Date in a principal amount equal to 1,200,000,000 Sol Credits (SC).</docset:CreditFacilityCommitment>
    </docset:CreditFacilityCommitment>
    <docset:InterestRateMargin dg:structure="section" dg:origin="3 184 197 2235 1391">
      <dg:chunk dg:structure="header" dg:origin="3 199 197 805 228" dg:style="font-weight: bold; color: darkslategray">
        <dg:chunk dg:structure="lim" dg:origin="3 321 197 390 228">2.02</dg:chunk> Section 2.02. Interest and Subordination.</dg:chunk>
      <dg:chunk dg:structure="ol" dg:origin="3 184 535 2235 1391">
        <dg:chunk dg:structure="li" dg:origin="3 184 535 1679 566" dg:style="color: darkslategray">
          <dg:chunk dg:structure="lim" dg:origin="3 184 535 210 566">1</dg:chunk> Interest Rate: The Loan shall bear interest at a fixed rate of <docset:InterestRateMargin dg:origin="3 1068 535 1351 566" dg:style="font-weight: bold">13.50% per annum</docset:InterestRateMargin>, <docset:InterestCompoundingOrAccrualBasis dg:origin="3 1360 535 1679 566">compounded quarterly</docset:InterestCompoundingOrAccrualBasis>.</dg:chunk>
        <docset:RepaymentSchedule dg:structure="li" dg:origin="3 184 872 2235 903; 3 231 922 2119 953; 3 231 972 684 1003" dg:style="color: darkslategray" xml:id="repaymentschedule" dg:itemprop="references" dg:href="#performanceindexthreshold">
          <dg:chunk dg:structure="lim" dg:origin="3 184 872 210 903">2</dg:chunk> Payment-in-Kind (PIK) Election: If the Borrower's Cash-on-Hand is less than <docset:PerformanceIndexThreshold dg:origin="3 1322 872 1532 903" xml:id="performanceindexthreshold">SC 50.0 million</docset:PerformanceIndexThreshold> due to unexpected micro-meteoroid armor repairs, the Borrower may elect to pay up to <docset:InterestRateMargin xsi:type="decimal" dg:value="5.0" dg:origin="3 733 922 804 953">5.0%</docset:InterestRateMargin> of the interest due in PIK notes, in which case such interest will be capitalized into the principal outstanding balance of the Loan.</docset:RepaymentSchedule>
        <docset:RepaymentSchedule dg:structure="li" dg:origin="3 184 1310 2138 1341; 3 231 1360 1191 1391" dg:style="color: darkslategray" xml:id="repaymentschedule-2" dg:itemprop="references" dg:href="#lenderoragententityname">
          <dg:chunk dg:structure="lim" dg:origin="3 184 1310 210 1341">3</dg:chunk> Subordination: The payment of principal and interest on the Mezzanine Loan is fully subordinated in right of payment to the Senior Credit Agreement held by the <docset:LenderOrAgentEntityName dg:origin="3 554 1360 1191 1391" xml:id="lenderoragententityname">Jovian-Saturnine Colonial Development Bank</docset:LenderOrAgentEntityName>.</docset:RepaymentSchedule>
      </dg:chunk>
    </docset:InterestRateMargin>
  </docset:CreditFacilityCommitment>
  <docset:RepresentationsAndWarranties dg:structure="section" dg:origin="3 199 1711 2281 2747">
    <dg:chunk dg:structure="header" dg:origin="3 199 1711 1767 1758" dg:style="font-weight: bold; font-size: 1.5em; text-transform: uppercase; color: darkslategray">ARTICLE III: ENVIRONMENTAL AND TECHNICAL REPRESENTATIONS</dg:chunk>
    <dg:chunk dg:structure="p" dg:origin="3 199 1997 997 2028" dg:style="color: darkslategray">The Borrower represents and warrants to the Lender that:</dg:chunk>
    <docset:StructuralOrEnvironmentalTolerance dg:structure="section" dg:origin="3 199 2256 2281 2388" xml:id="structuralorenvironmentaltolerance" dg:itemprop="describes" dg:href="#definedterms-3">
      <dg:chunk dg:structure="header" dg:origin="3 199 2256 777 2288" dg:style="font-weight: bold; color: darkslategray">
        <dg:chunk dg:structure="lim" dg:origin="3 330 2256 399 2288">3.01</dg:chunk> Section 3.01. Life-Support Reliability.</dg:chunk>
      <docset:StructuralOrEnvironmentalTolerance dg:structure="p" dg:origin="3 795 2256 2281 2288; 3 199 2306 2281 2338; 3 199 2356 297 2388" dg:style="color: darkslategray">The Spires' centralized life-support closed-loop recycling systems are rated to support up to <docset:PerformanceIndexThreshold xsi:type="integer" dg:value="12000" dg:origin="3 2185 2256 2281 2288">12,000</docset:PerformanceIndexThreshold> permanent human occupants at an average metabolic load of <docset:PerformanceIndexThreshold dg:origin="3 1069 2306 1336 2338">2,500 kcal per day</docset:PerformanceIndexThreshold>, with active oxygen and water reclamation efficiency of no less than <docset:PerformanceIndexThreshold xsi:type="decimal" dg:value="99.8" dg:origin="3 199 2356 297 2388">99.8%</docset:PerformanceIndexThreshold>.</docset:StructuralOrEnvironmentalTolerance>
    </docset:StructuralOrEnvironmentalTolerance>
    <docset:StructuralOrEnvironmentalTolerance dg:structure="section" dg:origin="3 199 2616 2281 2747" xml:id="structuralorenvironmentaltolerance-2" dg:itemprop="describes" dg:href="#definedterms-3">
      <dg:chunk dg:structure="header" dg:origin="3 199 2616 810 2647" dg:style="font-weight: bold; color: darkslategray">
        <dg:chunk dg:structure="lim" dg:origin="3 323 2616 392 2647">3.02</dg:chunk> Section 3.02. Radiation Protection Index.</dg:chunk>
      <docset:StructuralOrEnvironmentalTolerance dg:structure="p" dg:origin="3 820 2616 2281 2647; 3 199 2666 2281 2697; 3 199 2716 342 2747" dg:style="color: darkslategray">The electro-magnetic deflective shielding envelope surrounding the Spires is fully functional and capable of deflecting high-energy cosmic rays and Saturnian magnetospheric energetic particles down to safe occupational limits (<docset:PerformanceIndexThreshold dg:origin="3 2014 2666 2281 2697; 3 199 2716 342 2747">&lt; 20 mSv/Earth-year equivalent</docset:PerformanceIndexThreshold>).</docset:StructuralOrEnvironmentalTolerance>
    </docset:StructuralOrEnvironmentalTolerance>
  </docset:RepresentationsAndWarranties>
  <docset:CovenantsArticle dg:structure="section" dg:origin="3 199 3005 783 3052; 4 184 197 2261 1003">
    <dg:chunk dg:structure="header" dg:origin="3 199 3005 783 3052" dg:style="font-weight: bold; font-size: 1.5em; text-transform: uppercase; color: darkslategray">ARTICLE IV: COVENANTS</dg:chunk>
    <docset:AffirmativeCovenants dg:structure="section" dg:origin="4 184 197 2261 1003">
      <dg:chunk dg:structure="header" dg:origin="4 199 197 712 228" dg:style="font-weight: bold; color: darkslategray">
        <dg:chunk dg:structure="lim" dg:origin="4 321 197 390 228">4.01</dg:chunk> Section 4.01. Financial Covenants.</dg:chunk>
      <dg:chunk dg:structure="ol" dg:origin="4 184 535 2261 1003">
        <docset:MaintenanceCovenant dg:structure="li" dg:origin="4 184 535 2261 566; 4 231 585 1589 616" dg:style="color: darkslategray">
          <dg:chunk dg:structure="lim" dg:origin="4 184 535 210 566">1</dg:chunk> Debt Service Coverage Ratio (DSCR): The Borrower shall maintain a DSCR of not less than <docset:PerformanceIndexThreshold dg:origin="4 1537 535 1615 566" dg:style="font-weight: bold">1.15x</docset:PerformanceIndexThreshold> at the end of each fiscal quarter, calculated as Net Operating Cash Flow divided by the sum of Senior Debt Service and Mezzanine Debt Service.</docset:MaintenanceCovenant>
        <docset:AffirmativeCovenants dg:structure="li" dg:origin="4 184 922 2197 953; 4 231 972 1632 1003" dg:style="color: darkslategray" xml:id="affirmativecovenants" dg:itemprop="references" dg:href="#definedterms-2">
          <dg:chunk dg:structure="lim" dg:origin="4 184 922 210 953">2</dg:chunk> Occupancy Covenant: The Borrower shall maintain a weighted-average physical occupancy rate of not less than <docset:PerformanceIndexThreshold xsi:type="decimal" dg:value="72.5" dg:origin="4 1813 922 1901 953" dg:style="font-weight: bold">72.5%</docset:PerformanceIndexThreshold> across the Research Spires (measured by leased PVUs) and not less than <docset:PerformanceIndexThreshold xsi:type="decimal" dg:value="60.0" dg:origin="4 976 972 1064 1003" dg:style="font-weight: bold">60.0%</docset:PerformanceIndexThreshold> across the Elite Residential Penthouses.</docset:AffirmativeCovenants>
      </dg:chunk>
    </docset:AffirmativeCovenants>
  </docset:CovenantsArticle>
