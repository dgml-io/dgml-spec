  <docset:AgreementType dg:structure="section" dg:origin="1 240 580 1869 2897; 2 340 336 2210 956">
    <dg:chunk dg:structure="header" dg:origin="1 240 580 1525 635" dg:style="font-weight: bold; font-size: 1.25em; text-transform: uppercase; color: darkslategray">DOCUMENT <docset:DocumentIdentifier dg:origin="1 576 580 642 635" dg:style="text-transform: none">5A</docset:DocumentIdentifier>: <docset:AgreementType dg:origin="1 674 580 1525 635">SECURED CREDIT AGREEMENT</docset:AgreementType>
