    </dg:chunk>
    <dg:chunk dg:structure="section" dg:origin="1 240 580 1525 635">
      <dg:chunk dg:structure="header" dg:origin="1 240 580 1525 635" dg:style="font-weight: bold; font-size: 1.25em; color: darkslateblue">
        <docset:DocumentIdentifier dg:origin="1 240 580 642 635" dg:style="text-transform: uppercase">DOCUMENT 4A</docset:DocumentIdentifier>: <docset:AgreementType dg:origin="1 674 580 1525 635" dg:style="text-transform: uppercase">SECURED CREDIT AGREEMENT</docset:AgreementType>
