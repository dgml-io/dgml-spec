# ==========================================================================
# DGML docset schema — Borrower Periodic Operating Statement
# RELAX NG Compact.  Data types observed in 3 .dgml.xml file(s):
#   element text is the RAW page text; the normalized, typed value is
#   carried by @dg:value, described by @xsi:type (XSD built-in names).
# `# Field: value` comments are the LOSSLESS schema.json serialization;
#   regenerate the JSON via dgml_core.generation.rnc.rnc_to_schema_dict.
# ==========================================================================

default namespace docset = "http://dgml.io/acme-inc/BorrowerPeriodicOperatingStatement"
namespace dg = "http://dgml.io/ns/dg#"
namespace xsi = "http://www.w3.org/2001/XMLSchema-instance"
datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"

start = dg.chunk

# --- attributes common to every DGML element ------------------------
# dg:origin  = grounding bbox: "page x1 y1 x2 y2"
# dg:itemprop / dg:href = semantic link (predicate + '#id' target(s))
common.atts =
  attribute dg:structure { text }?,
  attribute dg:origin { text }?,
  attribute xml:id { xsd:ID }?,
  attribute dg:itemprop { text }?,
  attribute dg:href { text }?,
  attribute dg:value { text }?,
  attribute xsi:type { text }?

# --- generic structural chunk (unlabeled scaffolding) ----------------
dg.chunk = element dg:chunk { common.atts, mixed { any.docset* } }

# a concept private to ONE document renders in the dg: namespace instead
# of docset: (the shared-tag rule) — same shape, unshared vocabulary
dg.private = element dg:* { common.atts, mixed { any.docset* } }

# any docset element may appear where structure allows it
any.docset = dg.chunk
  | dg.private
  | BorrowerName
  | CalendarMonth
  | ComplianceMetricLabel
  | ComplianceMetricValue
  | CompliancePerformance
  | ConsolidatedOperatingPerformance
  | DebtServiceAmount
  | DebtServiceCalculation
  | DebtServiceLineLabel
  | ExpenseSubcategoryGroup
  | ExpenseSubcategorySubtotal
  | FirstMonthOfQuarter
  | GrossRevenueSubtotal
  | MonthlyExpenseAmount
  | MonthlyExpenseSubcategoryAmount
  | MonthlyGrossRevenueAmount
  | MonthlyNOIAmount
  | MonthlyRevenueAmount
  | MonthlyRevenueSubcategoryAmount
  | MonthlyTotalExpenseAmount
  | NetOperatingIncome
  | NetResidualCashFlow
  | NetResidualCashFlowMonthly
  | NetResidualCashFlowQuarterly
  | OperatingExpense
  | OperatingExpenseBreakdown
  | OperatingStatementDocument
  | QuarterlyExpenseAmount
  | QuarterlyExpenseSubcategoryAmount
  | QuarterlyGrossRevenueAmount
  | QuarterlyNOIAmount
  | QuarterlyRevenueAmount
  | QuarterlyRevenueSubcategoryAmount
  | QuarterlyTotalExpenseAmount
  | ReportingCurrency
  | ReportingPeriod
  | Revenue
  | RevenueBreakdown
  | RevenueSubcategoryGroup
  | RevenueSubcategorySubtotal
  | SecondMonthOfQuarter
  | TableColumnHeader
  | ThirdMonthOfQuarter
  | TotalOperatingExpenses

# ------------------------------------------------------------------
# Description: "Name of the borrowing entity submitting the operating statement"
# Kind: inline
# Parent: OperatingStatementDocument
# Example: "Hephaestus Regolith Refinery"
# Examples: ["Hephaestus Regolith Refinery", "Artemis Data Systems & Deep-Space Relay", "Selene-V Resort & Casino"]
# Observed: 3 occurrence(s)
BorrowerName = element BorrowerName {
  common.atts,
  text
}

# ------------------------------------------------------------------
# Description: "A specific month within the reporting quarter used as a column period for financial figures"
# Kind: inline
CalendarMonth = element CalendarMonth {
  common.atts,
  text
}

# ------------------------------------------------------------------
# Description: "The name or descriptor of the compliance or performance benchmark being reported (e.g. Required DSCR, Base SOFR Index Rate, TPV Index)"
# Kind: inline
# Parent: DebtServiceCalculation
# Example: "Required DSCR"
# Examples: ["Required DSCR", "Section 5.01", "Actual DSCR Achieved"]
# Observed: 12 occurrence(s)
ComplianceMetricLabel = element ComplianceMetricLabel {
  common.atts,
  text
}

# ------------------------------------------------------------------
# Description: "Atomic value of a compliance or performance benchmark indicator (e.g. required ratio, index rate, throughput figure)"
# Kind: inline
# Parent: DebtServiceCalculation
# Example: "June 26, 2026"
# Examples: ["June 26, 2026", "1.25x", "1.56x"]
# Observed: 13 occurrence(s); dg:structure: li(4)
# Data type (from DGML): date(4) of 13 occurrence(s)
ComplianceMetricValue = element ComplianceMetricValue {
  attribute dg:structure { text }?,
  attribute dg:origin { text }?,
  attribute xml:id { xsd:ID }?,
  attribute dg:itemprop { text }?,
  attribute dg:href { text }?,
  ((attribute xsi:type { "date" },
    attribute dg:value { xsd:date })
   | attribute dg:value { text })?,  # bare dg:value = link payload
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "Section summarising key compliance metrics and covenant benchmarks for the period"
# Kind: section
# Parent: OperatingStatementDocument
# Example: "Compliance & Performance Summary"
# Examples: ["Compliance & Performance Summary", "Required DSCR: 1.25x", "Actual DSCR Achieved: 1.56x (In Compliance)"]
# Observed: 9 occurrence(s); dg:structure: li(6), section(3)
# Children (from schema hierarchy): NetOperatingIncome
CompliancePerformance = element CompliancePerformance {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "Section presenting aggregated revenue and expense figures for the reporting period"
# Kind: section
# Parent: OperatingStatementDocument
# Example: "Consolidated Operating Performance"
# Examples: ["Consolidated Operating Performance", "Granular Performance & Operating Sub-Tables"]
# Observed: 6 occurrence(s); dg:structure: section(3), table(2), tr(1)
# Children (from schema hierarchy): FirstMonthOfQuarter, GrossRevenueSubtotal, OperatingExpenseBreakdown, Revenue, RevenueBreakdown, SecondMonthOfQuarter, TableColumnHeader, ThirdMonthOfQuarter, TotalOperatingExpenses
ConsolidatedOperatingPerformance = element ConsolidatedOperatingPerformance {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "Total principal and interest draw applied against net operating income in the period"
# Kind: row
# Parent: DebtServiceCalculation
# Example: "(31,050,000)"
# Examples: ["(31,050,000)"]
# Observed: 2 occurrence(s); dg:structure: tr(1), td(1)
# Children (from schema hierarchy): DebtServiceLineLabel
DebtServiceAmount = element DebtServiceAmount {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "Section reconciling net operating income against debt service obligations to derive residual cash flow"
# Kind: section
# Parent: OperatingStatementDocument
# Example: "Cross-Reference Note: The target ratio referenced herein as the \"Required DSCR\" "
# Examples: ["Cross-Reference Note: The target ratio referenced herein as the \"Required DSCR\" ", "Cross-Reference Note: Financial reports herein calculate dynamic debt coverage l", "Sub-Table C: Consolidated Debt Service Calculation"]
# Observed: 5 occurrence(s); dg:structure: p(3), section(1), table(1)
# Children (from schema hierarchy): ComplianceMetricLabel, ComplianceMetricValue, DebtServiceAmount, NetResidualCashFlow
DebtServiceCalculation = element DebtServiceCalculation {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "The descriptive label identifying the debt service draw row within the reconciliation table"
# Kind: inline
# Parent: DebtServiceAmount
# Example: "Debt Service Draw (Principal & Interest)"
# Examples: ["Debt Service Draw (Principal & Interest)"]
# Observed: 1 occurrence(s); dg:structure: td(1)
DebtServiceLineLabel = element DebtServiceLineLabel {
  common.atts,
  text
}

# ------------------------------------------------------------------
# Description: "A named grouping of related expense line items within the expense breakdown that carries its own subtotal"
# Kind: row
# Parent: OperatingExpenseBreakdown
# Example: "1. Thermal Control Infrastructure"
# Examples: ["1. Thermal Control Infrastructure", "Thermal Systems Subtotal", "2. Power, Compliance & Technical Staff"]
# Observed: 6 occurrence(s); dg:structure: td(4), tr(2)
# Children (from schema hierarchy): MonthlyExpenseSubcategoryAmount, QuarterlyExpenseSubcategoryAmount
ExpenseSubcategoryGroup = element ExpenseSubcategoryGroup {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "Aggregate monetary amount for a named group of related expense line items"
# Kind: row
# Parent: OperatingExpenseBreakdown
# Observed: 2 occurrence(s); dg:structure: tr(2)
ExpenseSubcategorySubtotal = element ExpenseSubcategorySubtotal {
  common.atts,
  mixed { any.docset* }
}

# ------------------------------------------------------------------
# Description: "The first calendar month (July) of the three-month reporting quarter"
# Kind: inline
# Parent: ConsolidatedOperatingPerformance
# Example: "July 2026 (LC)"
# Examples: ["July 2026 (LC)"]
# Observed: 5 occurrence(s); dg:structure: td(5)
FirstMonthOfQuarter = element FirstMonthOfQuarter {
  common.atts,
  text
}

# ------------------------------------------------------------------
