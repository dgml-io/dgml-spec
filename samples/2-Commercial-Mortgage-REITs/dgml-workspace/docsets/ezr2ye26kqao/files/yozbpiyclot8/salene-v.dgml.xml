<?xml version='1.0' encoding='utf-8'?>
<dg:chunk xmlns:dg="http://dgml.io/ns/dg#" xmlns:docset="http://dgml.io/acme-inc/SecuredCreditAgreement" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xhtml="http://www.w3.org/1999/xhtml" dg:origin="1 229 221 2321 2914; 2 229 265 919 1184">
  <docset:SecuredCreditAgreement dg:structure="section" dg:origin="1 229 221 2321 2914; 2 229 265 919 1184">
    <dg:chunk dg:structure="header" dg:origin="1 846 221 1704 296" dg:style="font-weight: bold; font-size: 1.5em">Secured Credit Agreement</dg:chunk>
    <docset:IntroductoryRecital dg:structure="p" dg:origin="1 229 452 2321 496; 1 229 518 2321 561; 1 229 583 1680 627" xml:id="introductoryrecital" dg:itemprop="effectiveOn" dg:href="#signaturedate">This SECURED CREDIT AGREEMENT (this "Agreement") is entered into as of the Effective Date by and between <docset:BorrowerName dg:origin="1 229 518 1124 561" dg:style="font-weight: bold; text-transform: uppercase" xml:id="borrowername">SELENE-V HOSPITALITY GROUP, INC.</docset:BorrowerName>, a <docset:BorrowerJurisdiction dg:origin="1 1211 518 1832 561">joint terrestrial-lunar corporation</docset:BorrowerJurisdiction> (the "Borrower"), and <docset:LenderName dg:origin="1 229 583 1406 627" dg:style="font-weight: bold; text-transform: uppercase" xml:id="lendername">LUNAR-INTERSTATE FINANCE CORPORATION (LIFC)</docset:LenderName> (the "Lender").</docset:IntroductoryRecital>
    <docset:DefinedTerms dg:structure="section" dg:origin="1 229 740 2239 1261">
      <dg:chunk dg:structure="header" dg:origin="1 229 740 1014 784" dg:style="font-weight: bold">Article I: Definitions and Correspondence</dg:chunk>
      <docset:DefinedTerms dg:structure="section" dg:origin="1 229 826 2239 1261">
        <dg:chunk dg:structure="header" dg:origin="1 229 826 764 870" dg:style="font-weight: bold">
          <dg:chunk dg:structure="lim" dg:origin="1 229 826 464 870">Section 1.01</dg:chunk> Defined Terms</dg:chunk>
        <dg:chunk dg:structure="p" dg:origin="1 775 826 2239 870">As used in this Agreement, the following terms have the meanings specified below:</dg:chunk>
        <dg:chunk dg:structure="ol" dg:origin="1 378 933 2167 1261">
          <docset:EffectiveDateDefinition dg:structure="li" dg:origin="1 378 933 2167 977" xml:id="effectivedatedefinition" dg:itemprop="effectiveOn" dg:href="#signaturedate">
            <dg:chunk dg:structure="lim">•</dg:chunk> "Effective Date": Defined explicitly as the "Execution Date" appearing alongside signatures below.</docset:EffectiveDateDefinition>
          <dg:chunk dg:structure="li" dg:origin="1 402 1028 2059 1072; 1 378 1123 402 1166">
            <dg:chunk dg:structure="lim">•</dg:chunk> "<docset:OperationalCovenantName dg:origin="1 402 1028 608 1072" dg:style="font-weight: bold">TPV Index</docset:OperationalCovenantName>": The Transit Passenger Volume Index calculated by the <docset:InterestIndex dg:origin="1 1625 1028 2059 1072">Copernicus Central Port</docset:InterestIndex>.</dg:chunk>
          <docset:OperationalCovenantName dg:structure="li" dg:origin="1 402 1123 1841 1166" xml:id="operationalcovenantname-3" dg:itemprop="references" dg:href="#operationalstandards" dg:value="Section 3.01">
            <dg:chunk dg:structure="lim">•</dg:chunk> "Humanitarian Non-Seizure Rule": The safety mandate set forth in Section 3.01.</docset:OperationalCovenantName>
          <docset:OperationalCovenantName dg:structure="li" dg:origin="1 378 1218 1941 1261" xml:id="operationalcovenantname-2" dg:itemprop="references" dg:href="#specialtyreservesorcovenants-2" dg:value="Section 3.02">
            <dg:chunk dg:structure="lim">•</dg:chunk> "Ecosystem Stability Level": The biological viability threshold defined in Section 3.02.</docset:OperationalCovenantName>
        </dg:chunk>
      </docset:DefinedTerms>
    </docset:DefinedTerms>
    <docset:CreditFacilityInterest dg:structure="section" dg:origin="1 229 1412 2321 1780">
      <dg:chunk dg:structure="header" dg:origin="1 229 1412 1116 1456" dg:style="font-weight: bold">Article II: Credit Terms &amp; Interest Modulation</dg:chunk>
      <docset:CreditFacilityCommitment dg:structure="section" dg:origin="1 229 1498 1809 1541">
        <dg:chunk dg:structure="header" dg:origin="1 229 1498 733 1541" dg:style="font-weight: bold">
          <dg:chunk dg:structure="lim" dg:origin="1 229 1498 464 1541">Section 2.01</dg:chunk> Commitment</dg:chunk>
        <docset:CreditFacilityCommitment dg:structure="p" dg:origin="1 744 1498 1809 1541">Lender agrees to loan Borrower the sum of <docset:PrincipalAmount dg:origin="1 1507 1498 1809 1541" dg:style="font-weight: bold">LC 320,000,000</docset:PrincipalAmount>.</docset:CreditFacilityCommitment>
      </docset:CreditFacilityCommitment>
      <docset:CreditFacilityInterest dg:structure="section" dg:origin="1 229 1605 2321 1780">
        <dg:chunk dg:structure="header" dg:origin="1 229 1605 967 1649" dg:style="font-weight: bold">
          <dg:chunk dg:structure="lim" dg:origin="1 229 1605 466 1649">Section 2.02</dg:chunk> Interest Rate Modulation</dg:chunk>
        <docset:CreditFacilityInterest dg:structure="p" dg:origin="1 980 1605 2321 1649; 1 229 1671 2321 1714; 1 229 1736 1093 1780" xml:id="creditfacilityinterest" dg:itemprop="references" dg:href="#operationalthreshold" dg:value="threshold">The interest rate on this facility shall dynamically adjust each quarter based on the registered "<docset:InterestIndex dg:origin="1 567 1671 776 1714" dg:style="font-weight: bold">TPV Index</docset:InterestIndex>" (defined in Section 1.01). If the "TPV Index" falls below <docset:OperationalThreshold dg:origin="1 1881 1671 2321 1714" xml:id="operationalthreshold">10,000 passengers/week</docset:OperationalThreshold>, the applicable rate escalates to <dg:InterestRate dg:origin="1 772 1736 1093 1780" xml:id="interestrate">7.50% per annum</dg:InterestRate>.</docset:CreditFacilityInterest>
      </docset:CreditFacilityInterest>
    </docset:CreditFacilityInterest>
    <docset:OperationalStandards dg:structure="section" dg:origin="1 229 1893 2321 2393">
      <dg:chunk dg:structure="header" dg:origin="1 229 1893 1223 1937" dg:style="font-weight: bold">Article III: Foreclosure and the Habitation Exclusion</dg:chunk>
      <docset:OperationalStandards dg:structure="section" dg:origin="1 229 1979 2321 2220" xml:id="operationalstandards">
        <dg:chunk dg:structure="header" dg:origin="1 229 1979 1427 2023" dg:style="font-weight: bold">
          <dg:chunk dg:structure="lim" dg:origin="1 229 1979 467 2023">Section 3.01</dg:chunk> Foreclosure and Humanitarian Non-Seizure Rule</dg:chunk>
        <docset:LenderRemedyOnDefault dg:structure="p" dg:origin="1 1442 1979 2321 2023; 1 229 2045 2321 2088; 1 229 2110 2321 2154; 1 229 2176 381 2220" xml:id="lenderremedyondefault" dg:itemprop="governedBy" dg:href="#operationalcovenantname" dg:value="collateral">Upon an Event of Default, Lender may foreclose on <docset:CollateralDescription dg:origin="1 292 2045 446 2088" xml:id="collateraldescription">Dome-5</docset:CollateralDescription>. However, under the "<docset:OperationalCovenantName dg:origin="1 870 2045 1493 2088" dg:style="font-weight: bold" xml:id="operationalcovenantname" dg:itemprop="references" dg:href="#operationalstandards" dg:value="Section 3.01">Humanitarian Non-Seizure Rule</docset:OperationalCovenantName>", Lender is strictly prohibited from shutting down or seizing core atmospheric scrubbers or environmental water recycling infrastructure necessary for occupant survival.</docset:LenderRemedyOnDefault>
      </docset:OperationalStandards>
      <docset:SpecialtyReservesOrCovenants dg:structure="section" dg:origin="1 229 2283 2321 2393" xml:id="specialtyreservesorcovenants-2">
        <dg:chunk dg:structure="header" dg:origin="1 229 2283 978 2327" dg:style="font-weight: bold">
          <dg:chunk dg:structure="lim" dg:origin="1 229 2283 467 2327">Section 3.02</dg:chunk> Ecosystem Stability Level</dg:chunk>
        <docset:SpecialtyReservesOrCovenants dg:structure="p" dg:origin="1 993 2283 2321 2327; 1 229 2349 1749 2393" xml:id="specialtyreservesorcovenants">The Borrower covenants to maintain a living botanical mass balance of at least <docset:FinancialCovenantThreshold xsi:type="decimal" dg:value="95" dg:origin="1 320 2349 400 2393">95%</docset:FinancialCovenantThreshold> of initial baseline parameters, referred to as the "<docset:FinancialCovenantName dg:origin="1 1270 2349 1749 2393" dg:style="font-weight: bold">Ecosystem Stability Level</docset:FinancialCovenantName>".</docset:SpecialtyReservesOrCovenants>
      </docset:SpecialtyReservesOrCovenants>
    </docset:OperationalStandards>
    <docset:EventsOfDefault dg:structure="section" dg:origin="1 229 2506 2321 2914; 2 229 265 919 1184">
      <dg:chunk dg:structure="header" dg:origin="1 229 2506 766 2549" dg:style="font-weight: bold">Article IV: Events of Default</dg:chunk>
      <docset:EventsOfDefault dg:structure="section" dg:origin="1 229 2591 2321 2914">
        <dg:chunk dg:structure="header" dg:origin="1 229 2591 826 2635" dg:style="font-weight: bold">
          <dg:chunk dg:structure="lim" dg:origin="1 229 2591 466 2635">Section 5.01</dg:chunk> Biological Default</dg:chunk>
        <docset:DefaultTriggerDescription dg:structure="p" dg:origin="1 839 2591 2321 2635; 1 229 2657 2321 2701; 1 229 2723 1659 2766" xml:id="defaulttriggerdescription" dg:itemprop="references" dg:href="#specialtyreservesorcovenants" dg:value="Section 3.02">Any failure to maintain the "<docset:FinancialCovenantName dg:origin="1 1359 2591 1842 2635" dg:style="font-weight: bold">Ecosystem Stability Level</docset:FinancialCovenantName>" (defined in Section 3.02) that is left unmitigated for <docset:DefaultCurePeriod dg:origin="1 738 2657 1157 2701">fifteen (15) Earth days</docset:DefaultCurePeriod> shall immediately trigger default clauses, subject to the safety protections of the "<docset:OperationalCovenantName dg:origin="1 571 2723 1178 2766" dg:style="font-weight: bold">Humanitarian Non-Seizure Rule</docset:OperationalCovenantName>" (defined in Section 3.01).</docset:DefaultTriggerDescription>
        <dg:chunk dg:structure="p" dg:origin="1 229 2871 2295 2914">IN WITNESS WHEREOF, the parties hereto have caused this Agreement to be executed as of the date written below.</dg:chunk>
      </docset:EventsOfDefault>
      <docset:BorrowerExecution dg:structure="section" dg:origin="2 229 265 809 637">
        <dg:chunk dg:structure="header" dg:origin="2 229 265 509 309" dg:style="font-weight: bold; text-transform: uppercase">BORROWER:</dg:chunk>
        <docset:BorrowerExecution dg:structure="p" dg:origin="2 229 331 809 374">
          <docset:BorrowerName dg:origin="2 229 331 809 374">Selene-V Hospitality Group, Inc.</docset:BorrowerName>
        </docset:BorrowerExecution>
        <dg:chunk dg:structure="p" dg:origin="2 229 462 292 506">By: ___________________________</dg:chunk>
        <docset:BorrowerExecution dg:structure="p" dg:origin="2 229 528 637 571">Name: <docset:BorrowerSignatory dg:origin="2 357 528 637 571" xml:id="borrowersignatory" dg:itemprop="signatoryOf" dg:href="#borrowername">Jean-Luc Carter</docset:BorrowerSignatory>
        </docset:BorrowerExecution>
        <docset:BorrowerExecution dg:structure="p" dg:origin="2 229 593 712 637">Title: <docset:Borrower dg:origin="2 335 593 712 637">Chief Leisure Officer</docset:Borrower>
        </docset:BorrowerExecution>
      </docset:BorrowerExecution>
      <docset:LenderExecution dg:structure="section" dg:origin="2 229 593 919 1184">
        <dg:chunk dg:structure="header" dg:origin="2 722 593 919 637" dg:style="font-weight: bold; text-transform: uppercase">LENDER:</dg:chunk>
        <docset:LenderExecution dg:structure="p" dg:origin="2 229 659 883 703">
          <docset:LenderName dg:origin="2 229 659 883 703">Lunar-Interstate Finance Corporation</docset:LenderName>
        </docset:LenderExecution>
        <dg:chunk dg:structure="p" dg:origin="2 229 790 292 834">By: ___________________________</dg:chunk>
        <docset:LenderExecution dg:structure="p" dg:origin="2 229 856 606 899">Name: <docset:LenderSignatory dg:origin="2 357 856 606 899" xml:id="lendersignatory" dg:itemprop="signatoryOf" dg:href="#lendername">Sarah Sterling</docset:LenderSignatory>
        </docset:LenderExecution>
        <docset:LenderExecution dg:structure="p" dg:origin="2 229 921 669 965">Title: <docset:Lender dg:origin="2 335 921 669 965">Managing Creditor</docset:Lender>
        </docset:LenderExecution>
        <dg:chunk dg:structure="p" dg:origin="2 229 1140 784 1184" dg:style="font-weight: bold">Execution Date: <docset:SignatureDate xsi:type="date" dg:value="2026-06-26" dg:origin="2 540 1140 784 1184" dg:style="font-weight: normal" xml:id="signaturedate">June 26, 2026</docset:SignatureDate>
        </dg:chunk>
      </docset:LenderExecution>
    </docset:EventsOfDefault>
  </docset:SecuredCreditAgreement>
